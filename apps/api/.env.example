DATABASE_URL=postgresql://loreal:loreal@localhost:5433/loreal_clienteling
# Force SSL on the pg Pool. Auto-on for Neon URLs or when sslmode=require is set.
PGSSL=false

BETTER_AUTH_SECRET=change-me-in-production-use-openssl-rand-base64-32
# AES-encrypts user-generated passwords so admins can reveal them later.
# Strong base64 (openssl rand -base64 32). Falls back to BETTER_AUTH_SECRET if empty.
USER_PASSWORD_KEY=
# Public URL of the API. Used as Better Auth baseURL and JWT issuer/audience.
BETTER_AUTH_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3001
PORT=3001

# Comma-separated origins allowed by CORS and by Better Auth's trustedOrigins.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
TRUSTED_ORIGINS=

NODE_ENV=development
# Force-enable Swagger in production (off by default when NODE_ENV=production).
ENABLE_SWAGGER=false

AI_SERVICE_URL=http://localhost:8000
ANTHROPIC_API_KEY=sk-ant-your-key-here
SENTRY_DSN=

R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=loreal-clienteling
R2_PUBLIC_URL=
