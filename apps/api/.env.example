DATABASE_URL=postgresql://loreal:loreal@localhost:5433/loreal_clienteling
# Force SSL on the pg Pool. Auto-on for Neon URLs or when sslmode=require is set.
PGSSL=false

# ── Clerk ────────────────────────────────────────────────────────────────────
# Backend API key from dashboard.clerk.com → API Keys → Secret keys.
CLERK_SECRET_KEY=sk_test_xxx
# Publishable key (only needed if the backend calls Clerk's public endpoints).
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Optional: PEM-encoded public key for offline JWT verification. When unset
# the backend falls back to fetching the JWKS via CLERK_SECRET_KEY.
CLERK_JWT_KEY=
# Signing secret from dashboard.clerk.com → Webhooks (svix).
CLERK_WEBHOOK_SECRET=whsec_xxx
# Optional: URL the user lands on after accepting an invitation.
CLERK_INVITATION_REDIRECT_URL=http://localhost:3000/accept-invitation

PUBLIC_API_URL=http://localhost:3001
PORT=3001

# Comma-separated origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

NODE_ENV=development
# Force-enable Swagger in production (off by default when NODE_ENV=production).
ENABLE_SWAGGER=false

# ── AI providers ─────────────────────────────────────────────────────────────
# Anthropic — primary LLM for summaries, note extraction, message suggestions.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_SUMMARY_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_SUGGESTION_MODEL=claude-haiku-4-5-20251001

# Deepgram — speech-to-text for voice-dictated notes (Spanish, Nova-3).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=es

# OpenAI — used only for text embeddings (semantic search). Not for LLM calls.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

SENTRY_DSN=

R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=loreal-clienteling
R2_PUBLIC_URL=

# ── Web Push (BA notifications) ──────────────────────────────────────────────
# VAPID keypair used to sign push payloads. Generate once with:
#   npx web-push generate-vapid-keys
# Leaving these unset puts the PushService in "disabled" mode — notifications
# still persist in DB but no OS-level push is dispatched.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: URL the push service contacts if your sender abuses the protocol.
VAPID_SUBJECT=mailto:notifications@loreal.local
