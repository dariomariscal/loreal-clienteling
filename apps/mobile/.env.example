# URL del API NestJS. En simulador: http://localhost:3001. En dispositivo físico
# usa la IP LAN del Mac (p.ej. http://192.168.1.20:3001) y agrégala a CORS_ORIGINS
# en apps/api/.env.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Publishable key de Clerk (dashboard.clerk.com → API Keys). NUNCA pongas la
# secret key aquí — esa vive solo en el backend.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
