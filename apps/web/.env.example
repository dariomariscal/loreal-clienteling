NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Clerk ────────────────────────────────────────────────────────────────────
# Get keys from dashboard.clerk.com → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Route paths Clerk uses for its prebuilt UI components and middleware redirects.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Mapbox public token for address autocomplete and static maps.
# Create one at https://account.mapbox.com/access-tokens/
# Public scopes only (styles:tiles, styles:read, fonts:read, datasets:read,
# vision:read). For production add a URL restriction to your domain.
NEXT_PUBLIC_MAPBOX_TOKEN=
