{
  "name": "@loreal/database",
  "private": true,
  "version": "0.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./schema/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx migrate.ts",
    "migrate:kit": "drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "seed": "tsx seed/index.ts",
    "seed:divisions": "tsx seed/divisions.ts",
    "seed:municipalities": "tsx seed/municipalities.ts",
    "seed:stores": "tsx seed/stores/index.ts",
    "seed:privacy-notices": "tsx seed/privacy-notices.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.11.0",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0"
  }
}
